# --- Core ---
PORT=3000
DATABASE_URL=postgresql://talk:talk@localhost:55442/talk
# Public URL providers use to reach /webhooks/voice (an ngrok URL during development)
PUBLIC_BASE_URL=http://localhost:3000
# Any long random string: openssl rand -hex 32
WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- Providers ---
VOICE_PROVIDER=fake            # vapi | fake
LEAD_SINK=log                  # google-sheets | log

# --- Dialer ---
DIALER_ENABLED=true
MAX_CONCURRENT_CALLS=4         # keep <= your Vapi plan's concurrent-call limit
MAX_ATTEMPTS=3
RETRY_DELAY_MINUTES=240
CALLING_HOURS_START=9          # lead's local time
CALLING_HOURS_END=20           # exclusive
DEFAULT_TIMEZONE=America/New_York

# --- Vapi (when VOICE_PROVIDER=vapi) ---
VAPI_API_KEY=
VAPI_PHONE_NUMBER_IDS=         # comma-separated ids of imported Twilio/Telnyx numbers
VAPI_LLM_MODEL=gpt-5.6-terra
VAPI_VOICE_ID=Layla
VAPI_VOICE_VERSION=2           # 1 | 2 | latest
VAPI_VOICE_PROVIDER=vapi       # vapi | 11labs | cartesia
VAPI_VOICE_MODEL=              # only for 11labs/cartesia, e.g. eleven_flash_v2_5 or sonic-3.5
VAPI_TRANSCRIBER_MODEL=flux-general-en  # Deepgram; flux detects end of turn itself. Fallback: nova-3
AGENT_NAME=Layla               # the name the agent introduces itself with; match the voice
# Number of a person on the team. When set, the agent transfers callers who ask for a human.
TRANSFER_PHONE_NUMBER=

# --- Google Sheets (when LEAD_SINK=google-sheets) ---
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB=Leads
GOOGLE_APPLICATION_CREDENTIALS=./google-service-account.json
