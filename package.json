{
  "name": "talk-leads",
  "version": "0.1.0",
  "private": true,
  "description": "Outbound AI calling that turns a CSV of phone numbers into booked appointments in a Google Sheet.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "import": "ts-node --transpile-only scripts/import-leads.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "lint": "tsc --noEmit -p tsconfig.json",
    "postinstall": "prisma generate",
    "check": "ts-node --transpile-only scripts/check-setup.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "csv-parse": "^7.0.3",
    "googleapis": "^183.0.0",
    "libphonenumber-js": "^1.13.14",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.5",
    "jest": "^30.5.2",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.9"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true
  }
}
